# ========================================================
# Prime Telecare — Production Environment Configuration
# ========================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production
APP_URL=https://app.primetelecare.com

# Cryptographic & Security Keys
# Generate a strong 32-byte secret: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_key_here
HMAC_PRESCRIPTION_SECRET=your_mdcn_prescription_signing_key_here

# Google Gemini AI Integration (Clinical Triage & Decision Support)
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway (Paystack / Flutterwave)
# Switch from test keys (sk_test_...) to live keys (sk_live_...) for production
PAYSTACK_PUBLIC_KEY=pk_test_sample_public_key
PAYSTACK_SECRET_KEY=sk_test_sample_secret_key
PAYSTACK_WEBHOOK_SECRET=whsec_sample_webhook_secret

# SMS & WhatsApp Notifications (Termii / Twilio)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=PrimeCare

# WebRTC Video Telemetry & TURN Relays (Coturn / Twilio Network Traversal)
# STUN/TURN servers ensure connection traversal through cellular carrier NATs (MTN/Airtel/Glo)
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.primetelecare.com:3478
TURN_USERNAME=prime_user
TURN_CREDENTIAL=prime_credential

